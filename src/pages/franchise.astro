---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Partners | OTA World"
  description="OTA World partnership: no franchise fee, no royalty. Inventory, training, delivery, and service from Carrollton."
>
  <main id="main">
    <section class="hero hero--short">
      <img class="hero-img" src="/assets/images/home-grid-2.jpg" alt="OTA World partner showroom" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="wrap hero-copy">
        <p class="eyebrow">Partners</p>
        <h1>Put the leading name on your door.</h1>
        <p class="hero-lede">No franchise fee. No royalty. Partner with America’s No. 1 house of massage chairs.</p>
        <div class="hero-actions">
          <a class="pill pill--light" href="/contact?topic=franchise">Request partner information</a>
        </div>
      </div>
    </section>

    <section class="stats" aria-label="Partnership terms">
      <div class="wrap stats-row">
        <p><b>$0</b><span>franchise fee</span></p>
        <p><b>0%</b><span>royalty</span></p>
        <p><b>$40K+</b><span>showroom inventory</span></p>
        <p><b>1</b><span>house behind every chair</span></p>
      </div>
    </section>

    <section class="section" aria-labelledby="who-heading">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2 id="who-heading">A showroom of America’s No. 1.</h2>
            <p class="section-sub">Made for operators who already know how to welcome a guest — and would rather sell the leading house than carry inventory, trucks, and warranty alone.</p>
          </div>
        </div>
        <div class="cards3">
          <article class="info-card"><h3>What you do</h3><p>Receive the guest. Let them sit. Complete the sale. The floor is your work.</p></article>
          <article class="info-card"><h3>What we do</h3><p>Training, delivery, installation, warranty, and after-service from Carrollton. The house behind every chair.</p></article>
          <article class="info-card"><h3>What you put in</h3><p>Showroom inventory, about $40,000 to $120,000, planned with headquarters. We walk the numbers in consultation.</p></article>
        </div>
      </div>
    </section>

    <section class="section section--gray" aria-labelledby="path-heading">
      <div class="wrap">
        <div class="section-head">
          <h2 id="path-heading">Four conversations. Then a door.</h2>
        </div>
        <div class="cards4">
          <article class="info-card"><span class="num">01</span><h3>Inquire</h3><p>A call or a note to headquarters — city, space, and intent.</p></article>
          <article class="info-card"><span class="num">02</span><h3>Consult</h3><p>We walk inventory, floor size, and what the house will carry.</p></article>
          <article class="info-card"><span class="num">03</span><h3>Stock</h3><p>Chairs arrive. Training happens. You are not left to invent the floor.</p></article>
          <article class="info-card"><span class="num">04</span><h3>Open</h3><p>You show. We deliver, install, and stand behind — for as long as the chair is in the home.</p></article>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="invest-heading">
      <div class="wrap narrow">
        <div class="section-head">
          <div>
            <h2 id="invest-heading">Investment at a glance</h2>
            <p class="section-sub">Figures follow the current site as a first draft. Confirm headquarters materials before any agreement.</p>
          </div>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Item</th><th>OTA HealthMate</th><th>PLUS</th></tr>
            </thead>
            <tbody>
              <tr><td>Franchise fee</td><td>None</td><td>None</td></tr>
              <tr><td>Royalty</td><td>None</td><td>None</td></tr>
              <tr><td>Showroom inventory</td><td>$40,000 – $65,000</td><td>$65,000 – $120,000</td></tr>
              <tr><td>Headquarters support</td><td colspan="2">Training · delivery · installation · service · warranty</td></tr>
            </tbody>
          </table>
        </div>
        <p class="fine">This table is a website summary. Lease, build-out, insurance, and other on-site costs vary by location.</p>
        <div class="btn-row">
          <a class="pill pill--dark" href="/contact?topic=franchise">Request partner information</a>
          <a class="pill pill--outline" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
