---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { site } from "../data/site";
import { budgets, byBrand, priceSource, products, type Brand } from "../data/catalog";

const brands = site.brands.map((b) => ({
  ...b,
  count: byBrand(b.name as Brand).length,
  host: b.url.replace(/^https?:\/\/(www\.)?/, ""),
}));
---

<BaseLayout
  title="Lineup | Osaki, Titan & AmaMedic Massage Chairs | OTA World"
  description={`Shop ${products.length} Osaki, Titan, and AmaMedic massage chairs with current prices from the official store — then sit with them at an OTA World floor.`}
  bodyPage="products"
>
  <main id="main">
    <section class="page-head">
      <div class="wrap">
        <p class="eyebrow">The lineup</p>
        <h1>Massage chairs</h1>
        <p class="page-lede">Osaki, Titan, and AmaMedic — {products.length} chairs from one house. Shop online at the official store, or sit with them first.</p>
      </div>
    </section>

    <section class="shop" data-shop>
      <div class="wrap shop-bar">
        <div class="chips" role="group" aria-label="Filter by brand">
          <button class="chip is-on" type="button" data-brand="all">All <span>{products.length}</span></button>
          {brands.map((b) => (
            <button class="chip" type="button" data-brand={b.name}>{b.name} <span>{b.count}</span></button>
          ))}
        </div>
        <div class="chips" role="group" aria-label="Filter by budget">
          <button class="chip is-on" type="button" data-budget="all">Any price</button>
          {budgets.map((b) => (
            <button class="chip" type="button" data-budget={b.id} data-min={b.min} data-max={b.max === Infinity ? "" : b.max}>{b.label}</button>
          ))}
        </div>
        <label class="sort">
          <span class="sr-only">Sort</span>
          <select data-sort>
            <option value="featured">Featured</option>
            <option value="low">Price: low to high</option>
            <option value="high">Price: high to low</option>
          </select>
        </label>
      </div>

      <div class="wrap">
        <p class="shop-count" aria-live="polite"><b data-count>{products.length}</b> chairs</p>
        <div class="grid" data-grid>
          {products.map((p, i) => <ProductCard product={p} lazy={i > 7} />)}
        </div>
        <p class="shop-empty" data-empty hidden>No chairs match. <button type="button" data-reset>Clear filters</button></p>
        <p class="price-note">
          Prices from <a href={priceSource.url} target="_blank" rel="noopener">{priceSource.name}</a> as of {priceSource.date}. Final price, promotions, and availability are set by the official store or your dealer. Retail prices may differ at partner floors.
        </p>
      </div>
    </section>

    <section class="section section--gray" aria-labelledby="brands-heading">
      <div class="wrap">
        <div class="section-head">
          <h2 id="brands-heading">Official brand stores</h2>
        </div>
        <div class="brand-links">
          {brands.map((b) => (
            <a href={b.url} target="_blank" rel="noopener">
              <h3>{b.name}</h3>
              <p>{b.host}</p>
              <span class="link-arrow">Visit store</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap band-inner">
        <div>
          <h2>Compare them in person.</h2>
          <p>Someone who knows the chairs will walk you through. Low pressure. Time to sit.</p>
        </div>
        <div class="btn-row">
          <a class="pill pill--light" href="/contact?topic=visit">Book a sitting</a>
          <a class="pill pill--ghost" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
