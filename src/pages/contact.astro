---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const mapsUrl = `https://maps.google.com/?q=${site.mapsQuery}`;
---

<BaseLayout
  title="Contact | OTA World"
  description={`Call OTA World headquarters at ${site.phoneDisplay}, or leave a note for a sitting, partnership, or service.`}
  bodyPage="contact"
>
  <main id="main">
    <section class="page-head">
      <div class="wrap">
        <p class="eyebrow">Contact</p>
        <h1>Start with a phone. Or a note.</h1>
        <p class="page-lede">A call is fastest. A note opens your mail app to headquarters.</p>
      </div>
    </section>

    <section class="section section--tight">
      <div class="wrap">
        <div class="cards3">
          <a class="info-card" href="/contact?topic=visit#note"><p class="eyebrow">Guests</p><h3>Book a sitting</h3><p>Flagship or a nearby gallery. Tell us your city and when you can come.</p></a>
          <a class="info-card" href="/contact?topic=service#note"><p class="eyebrow">Owners of a chair</p><h3>Care &amp; service</h3><p>Delivery, installation, warranty. The house stays after the truck.</p></a>
          <a class="info-card" href="/contact?topic=franchise#note"><p class="eyebrow">Owners of a floor</p><h3>A partnership</h3><p>No franchise fee. No royalty. You show. We do the rest.</p></a>
        </div>

        <div class="contact" id="note">
          <aside class="contact-card">
            <p class="eyebrow">Headquarters</p>
            <a class="big-phone" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
            <p><a href={`tel:${site.phoneLocalTel}`}>{site.phoneLocalDisplay}</a></p>
            <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
            <p>{site.addressLine}<br />{site.cityStateZip}</p>
            <dl class="hours">
              <div><dt>Monday – Friday</dt><dd>{site.hoursWeekday}</dd></div>
              <div><dt>Saturday</dt><dd>{site.hoursSaturday}</dd></div>
              <div><dt>Sunday</dt><dd>{site.hoursSunday}</dd></div>
            </dl>
            <a class="pill pill--light" href={mapsUrl} target="_blank" rel="noopener">Directions</a>
          </aside>
          <form class="form" data-contact>
            <h2>Send a note</h2>
            <p class="form-ok">Your mail app will open with the note for headquarters. If nothing opens, call {site.phoneDisplay} or email {site.email}.</p>
            <div class="form-row">
              <div class="field">
                <label for="name">Name</label>
                <input id="name" name="name" required autocomplete="name" />
              </div>
              <div class="field">
                <label for="phone">Phone</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" />
              </div>
            </div>
            <div class="form-row">
              <div class="field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" required autocomplete="email" />
              </div>
              <div class="field">
                <label for="topic">I am inquiring about</label>
                <select id="topic" name="topic">
                  <option value="visit">A showroom visit</option>
                  <option value="franchise">A partnership</option>
                  <option value="service">Care &amp; service</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label for="city">City</label>
              <input id="city" name="city" placeholder="So we can point you to a floor" autocomplete="address-level2" />
            </div>
            <div class="field">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5"></textarea>
            </div>
            <button class="pill pill--dark" type="submit">Send to headquarters</button>
            <p class="fine">Send opens your email app addressed to {site.email}.</p>
          </form>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
