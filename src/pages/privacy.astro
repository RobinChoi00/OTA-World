---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Privacy | OTA World"
  description="How OTA World, LLC handles inquiries sent to Carrollton headquarters."
>
  <main id="main">
    <section class="page-head">
      <div class="wrap narrow">
        <p class="eyebrow">{site.legalName}</p>
        <h1>Privacy</h1>
      </div>
    </section>
    <section class="section section--tight">
      <div class="wrap narrow prose">
        <p class="page-lede">
          Inquiries are used to answer you — a sitting, a partnership, or service. We do not sell your
          name, phone, or email.
        </p>
        <p>
          The contact form opens your own mail app to {site.email}. Anything you send that way is
          handled by headquarters at {site.addressLine}, {site.cityStateZip}, so we can call you back.
          To ask what we hold, or to ask it be removed, call
          <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
          or write
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
        <p>
          Product prices shown on this site are copied from the official brand store and link to it.
          Purchases made there are covered by that store’s own notice. Brand sites at osakiusa.com,
          titanchair.com, and amamedic.com have their own notices, and embedded YouTube videos and
          Google Maps are governed by Google’s policies.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
