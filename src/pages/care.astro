---
import BaseLayout from "../layouts/BaseLayout.astro";
import { footprint, site } from "../data/site";
---

<BaseLayout
  title="Care & Service | OTA World"
  description="Delivery, installation, and warranty for Osaki, Titan, and AmaMedic stay with OTA World in Carrollton."
>
  <main id="main">
    <section class="hero hero--short">
      <img class="hero-img" src="/assets/products/titan-pro-4d-astro-wide.webp" alt="A man relaxing in a Titan Pro 4D Astro" fetchpriority="high" style="object-position:50% 15%" />
      <div class="hero-shade"></div>
      <div class="wrap hero-copy">
        <p class="eyebrow">Care &amp; service</p>
        <h1>The house behind the chair.</h1>
        <p class="hero-lede">Delivery and installation into the room. Warranty and repair through Carrollton.</p>
        <div class="hero-actions">
          <a class="pill pill--light" href="/contact?topic=service">Request service</a>
          <a class="pill pill--ghost" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="promise-heading">
      <div class="wrap">
        <h2 id="promise-heading" class="center-title">From the floor to the years after</h2>
        <div class="why">
          {footprint.map((f, i) => (
            <article>
              <span class="why-icon" aria-hidden="true">0{i + 1}</span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--gray" aria-labelledby="next-heading">
      <div class="wrap duo duo--text">
        <div class="duo-copy">
          <p class="eyebrow">After you sit</p>
          <h2 id="next-heading">What happens next.</h2>
          <p>Once a chair is chosen, Carrollton stays on the work: the truck, the room, and the years after.</p>
          <ol class="steps">
            <li>Headquarters schedules delivery with you.</li>
            <li>The chair is installed in the room — not left at the curb.</li>
            <li>If service is needed, you call the same house that showed it.</li>
          </ol>
        </div>
        <div class="contact-card">
          <p class="eyebrow">Need help</p>
          <h3>Call the house first.</h3>
          <p>A person at headquarters is the shortest path — for a guest, a partner floor, or a chair already at home.</p>
          <a class="big-phone" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
          <p><a href={`tel:${site.phoneLocalTel}`}>{site.phoneLocalDisplay}</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
          <a class="pill pill--light" href="/contact?topic=service">Request service</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
