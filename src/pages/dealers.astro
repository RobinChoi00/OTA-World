---
import BaseLayout from "../layouts/BaseLayout.astro";
import { retailPartners, site, storeJsonLd } from "../data/site";

const mapsUrl = `https://maps.google.com/?q=${site.mapsQuery}`;
---

<BaseLayout
  title="Dealer Locator | OTA World"
  description={`Find an OTA World showroom or major retail floor. Flagship: Carrollton, TX. Call ${site.phoneDisplay}.`}
  jsonLd={storeJsonLd}
>
  <main id="main">
    <section class="hero hero--short hero--overlap">
      <img class="hero-img" src="/assets/images/home4.jpeg" alt="OTA World flagship showroom interior" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="wrap hero-copy">
        <p class="eyebrow">Dealer Locator</p>
        <h1>Find a floor near you.</h1>
        <p class="hero-lede">The Carrollton flagship, partner galleries, and major retail.</p>
      </div>
    </section>

    <section class="locator" aria-labelledby="locator-heading">
      <div class="wrap locator-card">
        <div>
          <h2 id="locator-heading">Where should we send you?</h2>
          <p>Leave your city or ZIP. Headquarters will reply with the nearest OTA World floor or retail location.</p>
        </div>
        <form class="inline-form" action={`mailto:${site.email}`} method="get" enctype="text/plain">
          <input type="hidden" name="subject" value="Dealer Locator request — OTA World" />
          <label class="sr-only" for="locator-zip">City or ZIP</label>
          <input id="locator-zip" type="text" name="body" required placeholder="e.g. Dallas, TX or 75006" autocomplete="postal-code" />
          <button class="pill pill--dark" type="submit">Find a dealer</button>
        </form>
        <p class="locator-or">or call <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></p>
      </div>
    </section>

    <section class="section" aria-label="Ways to sit">
      <div class="wrap cards4">
        <a class="info-card" href="#flagship">
          <span class="num">01</span>
          <h3>Flagship</h3>
          <p>{site.addressLine}, Carrollton. Weekdays 9:30–6:30, Saturday 10–4.</p>
        </a>
        <a class="info-card" href="/contact?topic=visit">
          <span class="num">02</span>
          <h3>Book a sitting</h3>
          <p>Leave your city and a time that works. Headquarters arranges the floor.</p>
        </a>
        <a class="info-card" href="#retail">
          <span class="num">03</span>
          <h3>Major retail</h3>
          <p>Costco, Ashley, Amazon, Sam’s Club — sit where you already shop.</p>
        </a>
        <a class="info-card" href={`tel:${site.phoneTel}`}>
          <span class="num">04</span>
          <h3>Call headquarters</h3>
          <p>A person who knows the network — the fastest door for most guests.</p>
        </a>
      </div>
    </section>

    <section class="section section--gray" id="flagship" aria-labelledby="flagship-heading">
      <div class="wrap duo">
        <div class="duo-media">
          <img src="/assets/images/home-grid-1.jpg" alt="OTA World headquarters in Carrollton" loading="lazy" />
        </div>
        <div class="duo-copy">
          <p class="eyebrow">Flagship</p>
          <h2 id="flagship-heading">Carrollton headquarters</h2>
          <p>{site.addressLine}<br />{site.cityStateZip}</p>
          <p>
            <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a> · <a href={`tel:${site.phoneLocalTel}`}>{site.phoneLocalDisplay}</a>
          </p>
          <dl class="hours">
            <div><dt>Monday – Friday</dt><dd>{site.hoursWeekday}</dd></div>
            <div><dt>Saturday</dt><dd>{site.hoursSaturday}</dd></div>
            <div><dt>Sunday</dt><dd>{site.hoursSunday}</dd></div>
          </dl>
          <div class="btn-row">
            <a class="pill pill--dark" href="/contact?topic=visit">Book a sitting</a>
            <a class="pill pill--outline" href={mapsUrl} target="_blank" rel="noopener">Directions</a>
          </div>
        </div>
      </div>
      <div class="wrap">
        <div class="map">
          <iframe title="Map of OTA World headquarters in Carrollton" src="https://maps.google.com/maps?q=1001+W.+Crosby+Ln,+Carrollton,+TX+75006&z=15&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>

    <section class="partners" id="retail" aria-labelledby="retail-heading">
      <div class="wrap partners-inner">
        <h2 id="retail-heading">Also available in major retail</h2>
        <ul>
          {retailPartners.map((partner) => (
            <li><a href={partner.href} target="_blank" rel="noopener noreferrer">{partner.name}</a></li>
          ))}
        </ul>
      </div>
      <p class="wrap partners-note">Need a specific city? <a href="/contact?topic=visit">Tell us where you are</a> — we will point you to the nearest floor.</p>
    </section>

    <section class="section" aria-labelledby="rooms-heading">
      <div class="wrap">
        <div class="section-head">
          <h2 id="rooms-heading">OTA World galleries</h2>
          <p class="section-sub">Headquarters and partner floors — made for sitting.</p>
        </div>
        <div class="gallery">
          <figure><img src="/assets/images/home4.jpeg" alt="OTA World flagship interior" loading="lazy" /><figcaption>Flagship interior</figcaption></figure>
          <figure><img src="/assets/images/home-grid-2.jpg" alt="OTA World mall showroom" loading="lazy" /><figcaption>A partner gallery</figcaption></figure>
          <figure><img src="/assets/images/home-grid-4.jpg" alt="OTA World suite entrance" loading="lazy" /><figcaption>A house storefront</figcaption></figure>
          <figure><img src="/assets/images/home-grid-5.jpg" alt="Illuminated OTA World sign" loading="lazy" /><figcaption>The house at night</figcaption></figure>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
