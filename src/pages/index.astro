---
import BaseLayout from '../layouts/BaseLayout.astro';
import { orgJsonLd, retailPartners, site } from '../data/site';
const jsonLd = orgJsonLd;
const videoSrc = `https://www.youtube.com/embed/${site.youtubeId}?rel=0`;
const lineup = [
  { ...site.brands[0], image: '/assets/images/osaki-lifestyle.jpg', alt: 'Osaki Highpointe 4D', line: 'Innovation as a standard. America’s leading name in the chair.' },
  { ...site.brands[1], image: '/assets/images/titan-chair.jpg', alt: 'Titan Remedy Pro 4D', line: 'Power without apology. Built for the body that sits in it.' },
  { ...site.brands[2], image: '/assets/images/amamedic-lifestyle.webp', alt: 'AmaMedic Haven', line: 'Recovery, quietly. Therapeutic comfort without the appointment.' },
];
---

<BaseLayout
  title='OTA World | America’s No. 1 House of Massage Chairs'
  description='OTA World, LLC — America’s No. 1 choice for massage chairs. The house of Osaki, Titan, and AmaMedic. Carrollton, Texas since 2005. 35% U.S. share.'
  ogTitle='OTA World | America’s No. 1'
  ogDescription='The American house of Osaki, Titan, and AmaMedic. No. 1 choice for massage chairs in the U.S.'
  bodyPage='home'
  jsonLd={jsonLd}
>
<main id="main">
    <section class="hero">
      <div class="hero-media">
        <img src="/assets/images/home4.jpeg" alt="OTA World flagship showroom in Carrollton" />
      </div>
      <div class="hero-veil"></div>
      <div class="hero-corners" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </div>
      <p class="hero-llc">America’s No. 1</p>
      <div class="hero-identity">
        <p class="hero-place">No. 1 in the United States · Est. 2005</p>
        <h1><span class="hero-ota">OTA</span> <span class="hero-world">World</span></h1>
        <p class="lede">OTA is Osaki, Titan, and AmaMedic. America’s No. 1 choice in massage chairs.</p>
        <div class="hero-actions">
          <a class="btn btn-gold" href="/dealers">Dealer Locator</a>
          <a class="btn btn-outline" href="/about">The company</a>
        </div>
      </div>
    </section>

    <div class="floorbar">
      <p>
        <b>Call the house</b>
        <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
      </p>
      <p>
        <b>Headquarters</b>
        <span>{site.addressLine}<br />{site.cityStateZip}</span>
      </p>
      <p>
        <b>Flagship hours</b>
        <span>Mon–Fri {site.hoursWeekday}<br />Sat {site.hoursSaturday} · Sun closed</span>
      </p>
    </div>

    <div class="proof">
      <span><b>No. 1</b> in the U.S.</span>
      <span><b>35%</b> U.S. share</span>
      <span><b>$3B</b> market by 2026</span>
      <span><b>2005</b> Carrollton</span>
    </div>

    <section class="partner-rail" aria-labelledby="partners-heading" data-reveal>
      <div class="container partner-rail-head">
        <div class="kicker">Where America sits with us</div>
        <h2 id="partners-heading">Trusted in major retail.</h2>
        <p class="intro">Osaki, Titan, and AmaMedic reach guests through national floors — and through OTA World showrooms across the country.</p>
      </div>
      <ul class="partner-marks">
        {retailPartners.map((partner) => (
          <li>
            <a href={partner.href} target="_blank" rel="noopener noreferrer" aria-label={partner.name}>
              <span class={`partner-wordmark partner-${partner.name.toLowerCase().replace(/[^a-z]/g, "")}`}>{partner.name}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="partner-rail-note">
        <a href="/dealers">Find a dealer near you <i aria-hidden="true">→</i></a>
      </p>
    </section>

    <section class="film-band" aria-labelledby="film-heading" data-reveal>
      <div class="film-band-head">
        <div class="kicker">The chairs</div>
        <h2 id="film-heading">See the lineup in motion.</h2>
        <p class="intro">A short look at the high-end chairs of this house — then sit with them in person.</p>
        <a class="btn btn-gold" href="/dealers">Find a dealer</a>
      </div>
      <div class="film-frame">
        <iframe
          src={videoSrc}
          title="OTA World high-end massage chairs"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </section>

    <section class="house-visuals" aria-labelledby="house-visuals-heading" data-reveal>
      <div class="house-visuals-copy">
        <div class="kicker" style="color:var(--gold-light)">The Carrollton house</div>
        <h2 id="house-visuals-heading">Showroom. Warehouse.<br />One address.</h2>
        <p>Headquarters since 2005 — sit on the floor, stock in the building, service from the same roof.</p>
        <div class="btn-row" style="margin-top:28px">
          <a class="btn btn-gold" href="/dealers#flagship">Visit the flagship</a>
          <a class="btn btn-outline-light" href="/about">Our story</a>
        </div>
      </div>
      <div class="house-visuals-grid">
        <figure>
          <img src="/assets/images/home-grid-1.jpg" alt="OTA World headquarters exterior sign" />
          <figcaption>Headquarters · Crosby Ln.</figcaption>
        </figure>
        <figure>
          <img src="/assets/images/home4.jpeg" alt="OTA World flagship showroom interior" />
          <figcaption>Flagship showroom</figcaption>
        </figure>
        <figure>
          <img src="/assets/images/home-grid-6.jpg" alt="OTA World storefront at night" />
          <figcaption>The house at night</figcaption>
        </figure>
        <figure>
          <img src="/assets/images/home-grid-5.jpg" alt="OTA World illuminated exterior" />
          <figcaption>Warehouse &amp; floor</figcaption>
        </figure>
      </div>
    </section>

    <section class="lineup-row" aria-labelledby="lineup-heading">
      <div class="container lineup-row-head" data-reveal>
        <div class="kicker" style="color:var(--gold-light)">The lineup</div>
        <h2 id="lineup-heading">Three names. One house.</h2>
        <a class="lineup-row-all" href="/products">See the full lineup <i aria-hidden="true">→</i></a>
      </div>
      <div class="lineup-cards">
        {lineup.map((brand, i) => (
          <article data-reveal style={i ? `--delay:${i * 0.08}s` : undefined}>
            <div class="lineup-photo">
              <img src={brand.image} alt={brand.alt} loading="lazy" />
            </div>
            <div class="lineup-copy">
              <div class="num">Lineup 0{i + 1}</div>
              <h3>{brand.name}</h3>
              <p>{brand.line}</p>
              <div class="lineup-links">
                <a class="btn btn-gold" href="/dealers">Sit with {brand.name}</a>
                <a class="lineup-site" href={brand.url} target="_blank" rel="noopener">{brand.url.replace(/^https?:\/\/(www\.)?/, "")} <i aria-hidden="true">↗</i></a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="doors">
      <a class="door-photo" href="/dealers" style="background-image:url(/assets/images/home4.jpeg)" data-reveal>
        <div class="kicker">For the home</div>
        <h2>Find a dealer.</h2>
        <p>Flagship, partner gallery, or major retail. The chair is decided in the room.</p>
      </a>
      <a class="door-photo" href="/franchise" data-reveal style="background-image:url(/assets/images/home-grid-2.jpg);--delay:0.1s">
        <div class="kicker">For the owner</div>
        <h2>Put our name on your door.</h2>
        <p>No franchise fee. No royalty. You show the chair. The house does the rest.</p>
      </a>
    </section>

    <section class="section cta-band">
      <div class="container">
        <div class="kicker">The leading house is open</div>
        <h2>OTA World, LLC</h2>
        <p>America’s No. 1 choice in massage chairs. Sit in Carrollton. Or put our name on your door.</p>
        <a class="phone-xl" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
        <div class="btn-row" style="justify-content:center">
          <a class="btn btn-gold" href="/contact">Contact headquarters</a>
          <a class="btn btn-outline" href="/dealers">Dealer Locator</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
