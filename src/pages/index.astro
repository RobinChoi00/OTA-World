---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductRail from "../components/ProductRail.astro";
import { orgJsonLd, retailPartners, site } from "../data/site";
import { budgets, byBrand, featured, find, inBudget, model, products, usd } from "../data/catalog";

const videoSrc = `https://www.youtube.com/embed/${site.youtubeId}?rel=0`;
const spotlight = find("osaki-pro-4d-epic-le");
const brandPanels = [
  {
    name: "Osaki",
    line: "Innovation as a standard.",
    image: "/assets/products/osaki-aeris-4d-duo-wide.webp",
    alt: "Osaki Aeris 4D Duo in a living room",
    models: byBrand("Osaki").slice(0, 5),
  },
  {
    name: "Titan",
    line: "Power without apology.",
    image: "/assets/products/titan-vega-duo-massage-chair-wide.webp",
    alt: "Titan Vega Duo in a city apartment",
    models: byBrand("Titan").slice(0, 5),
  },
  {
    name: "AmaMedic",
    line: "Recovery, quietly.",
    image: "/assets/products/amamedic-haven-4d-wide.webp",
    alt: "AmaMedic Haven 4D in a living room",
    models: byBrand("AmaMedic"),
  },
];
const budgetCards = budgets.map((b) => ({
  ...b,
  count: products.filter((p) => inBudget(p, b.id)).length,
  image: products.find((p) => inBudget(p, b.id) && p.featured)?.image ?? products.find((p) => inBudget(p, b.id))!.image,
}));
---

<BaseLayout
  title="OTA World | Osaki, Titan & AmaMedic Massage Chairs"
  description="OTA World, LLC — America’s No. 1 choice for massage chairs. Shop Osaki, Titan, and AmaMedic, then sit with them in Carrollton, Texas. Since 2005."
  ogTitle="OTA World | America’s No. 1 house of massage chairs"
  ogDescription="Osaki, Titan, and AmaMedic. Shop the lineup, then sit before you buy."
  bodyPage="home"
  jsonLd={orgJsonLd}
>
  <main id="main">
    <section class="hero">
      <img class="hero-img" src="/assets/products/osaki-ai-apex-5d-4d-duo-wide.webp" alt="A man rising from an Osaki Ai Apex Duo massage chair" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="wrap hero-copy">
        <p class="eyebrow">America’s No. 1 choice for massage chairs</p>
        <h1>Recovery,<br />built in.</h1>
        <p class="hero-lede">Osaki, Titan, and AmaMedic — one house since {site.founded}.</p>
        <div class="hero-actions">
          <a class="pill pill--light" href="/products">Shop the lineup</a>
          <a class="pill pill--ghost" href="/dealers">Find a dealer</a>
        </div>
      </div>
    </section>

    <ProductRail id="featured-heading" title="Featured chairs" products={featured} />

    <section class="brand-panels" aria-label="Shop by brand">
      {brandPanels.map((b) => (
        <article class="brand-panel">
          <img src={b.image} alt={b.alt} loading="lazy" />
          <div class="brand-panel-copy">
            <p class="eyebrow">{b.line}</p>
            <h2>{b.name}</h2>
            <ul>
              {b.models.map((m) => (
                <li><a href={m.url} target="_blank" rel="noopener">{model(m)}</a></li>
              ))}
            </ul>
            <a class="pill pill--light" href={`/products?brand=${b.name}`}>Shop {b.name}</a>
          </div>
        </article>
      ))}
    </section>

    <section class="section" aria-labelledby="budget-heading">
      <div class="wrap">
        <div class="section-head">
          <h2 id="budget-heading">Shop by budget</h2>
          <a class="link-arrow" href="/products">All {products.length} chairs</a>
        </div>
        <div class="tiles">
          {budgetCards.map((b) => (
            <a class="tile" href={`/products?budget=${b.id}`}>
              <img src={b.image} alt="" loading="lazy" />
              <div>
                <h3>{b.label}</h3>
                <p>{b.text}</p>
                <span class="pill pill--dark pill--sm">{b.count} chairs</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="spotlight" aria-labelledby="spotlight-heading">
      <img src={spotlight.scene} alt={`${spotlight.name} in a living room`} loading="lazy" />
      <div class="wrap spotlight-inner">
        <div class="spotlight-card">
          <p class="eyebrow">Spotlight · {spotlight.brand}</p>
          <h2 id="spotlight-heading">{model(spotlight)}</h2>
          <ul class="ticks">
            {spotlight.features.map((f) => <li>{f}</li>)}
          </ul>
          <p class="spotlight-price">
            <b>{usd(spotlight.price)}</b>
            {spotlight.compareAt && <s>{usd(spotlight.compareAt)}</s>}
          </p>
          <div class="btn-row">
            <a class="pill pill--dark" href={spotlight.url} target="_blank" rel="noopener">Shop now</a>
            <a class="pill pill--outline" href="/dealers">Sit with it</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--dark" aria-labelledby="film-heading">
      <div class="wrap film">
        <div class="film-copy">
          <p class="eyebrow">In motion</p>
          <h2 id="film-heading">See the chairs at work.</h2>
          <p>A short look at the high-end chairs of this house — then sit with them in person.</p>
          <a class="pill pill--light" href="/dealers">Find a dealer</a>
        </div>
        <div class="film-frame">
          <iframe
            src={videoSrc}
            title="OTA World high-end massage chairs"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="house-heading">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2 id="house-heading">Showroom. Warehouse. One address.</h2>
            <p class="section-sub">Headquarters in Carrollton since {site.founded} — sit on the floor, stock in the building, service from the same roof.</p>
          </div>
          <a class="link-arrow" href="/dealers#flagship">Visit the flagship</a>
        </div>
        <div class="mosaic">
          <figure class="mosaic-big">
            <img src="/assets/images/home4.jpeg" alt="OTA World flagship showroom interior" loading="lazy" />
            <figcaption>Flagship showroom</figcaption>
          </figure>
          <figure>
            <img src="/assets/images/home-grid-1.jpg" alt="OTA World headquarters exterior sign" loading="lazy" />
            <figcaption>Headquarters · Crosby Ln.</figcaption>
          </figure>
          <figure>
            <img src="/assets/images/home-grid-5.jpg" alt="OTA World warehouse and floor at night" loading="lazy" />
            <figcaption>Warehouse &amp; floor</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="partners" aria-labelledby="partners-heading">
      <div class="wrap partners-inner">
        <h2 id="partners-heading">Also on the floor at</h2>
        <ul>
          {retailPartners.map((partner) => (
            <li>
              <a href={partner.href} target="_blank" rel="noopener noreferrer">{partner.name}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="why-heading">
      <div class="wrap">
        <h2 id="why-heading" class="center-title">Why buy from the house</h2>
        <div class="why">
          <article>
            <span class="why-icon" aria-hidden="true">01</span>
            <h3>Sit before you buy</h3>
            <p>Every model is decided in the room — at the flagship or a partner floor.</p>
          </article>
          <article>
            <span class="why-icon" aria-hidden="true">02</span>
            <h3>Delivered &amp; installed</h3>
            <p>White-glove into the room, set up where it lives, tested before we leave.</p>
          </article>
          <article>
            <span class="why-icon" aria-hidden="true">03</span>
            <h3>Warranty from the house</h3>
            <p>Osaki, Titan, and AmaMedic are stood behind from Carrollton.</p>
          </article>
          <article>
            <span class="why-icon" aria-hidden="true">04</span>
            <h3>A person answers</h3>
            <p>Call <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a> — the same house that showed the chair.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="split-cta" aria-label="Next steps">
      <a class="split-cta-card" href="/dealers" style="background-image:url(/assets/images/home-grid-2.jpg)">
        <p class="eyebrow">For the home</p>
        <h2>Find a dealer</h2>
        <span class="pill pill--light">Dealer Locator</span>
      </a>
      <a class="split-cta-card" href="/franchise" style="background-image:url(/assets/images/home-grid-6.jpg)">
        <p class="eyebrow">For the owner</p>
        <h2>Put our name on your door</h2>
        <span class="pill pill--light">Become a partner</span>
      </a>
    </section>
  </main>
</BaseLayout>
