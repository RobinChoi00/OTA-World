---
import BaseLayout from "../layouts/BaseLayout.astro";
import { mission, purposePillars, site } from "../data/site";
import { find } from "../data/catalog";

const letters = [
  { letter: "O", name: "Osaki", text: "Innovation as a standard. A spa that lives at home.", image: find("osaki-pro-4d-epic-le").image },
  { letter: "T", name: "Titan", text: "Power without apology. Built for the body that sits in it.", image: find("titan-vega-duo-massage-chair").image },
  { letter: "A", name: "AmaMedic", text: "Recovery, quietly. Therapeutic comfort without the appointment.", image: find("amamedic-haven-4d").image },
];
---

<BaseLayout
  title="The Brand | OTA World"
  description="OTA is Osaki, Titan, and AmaMedic. OTA World, LLC is America’s No. 1 choice for massage chairs. Founded in Carrollton, Texas in 2005."
  bodyPage="about"
>
  <main id="main">
    <section class="hero hero--short">
      <img class="hero-img" src="/assets/images/home-grid-6.jpg" alt="OTA World storefront at night" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="wrap hero-copy">
        <p class="eyebrow">The Brand</p>
        <h1>The leading house in America.</h1>
        <p class="hero-lede">OTA is Osaki, Titan, and AmaMedic. Founded in Carrollton in {site.founded}.</p>
      </div>
    </section>

    <section class="stats" aria-label="At a glance">
      <div class="wrap stats-row">
        <p><b>No. 1</b><span>choice in the U.S.</span></p>
        <p><b>35%</b><span>reported U.S. share</span></p>
        <p><b>$3B</b><span>market by 2026</span></p>
        <p><b>{site.founded}</b><span>Carrollton, Texas</span></p>
      </div>
    </section>

    <section class="manifesto" aria-labelledby="about-mission">
      <div class="wrap">
        <p class="eyebrow">{mission.kicker}</p>
        <h2 id="about-mission">
          {mission.lines.map((line) => <span>{line}</span>)}
        </h2>
        <p class="manifesto-note">{mission.footnote}</p>
      </div>
    </section>

    <section class="section" aria-labelledby="name-heading">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2 id="name-heading">OTA is the three names, written as one.</h2>
            <p class="section-sub">The letters are the house — not a slogan beside the brands, but the brands themselves.</p>
          </div>
        </div>
        <div class="letters">
          {letters.map((l) => (
            <a class="letter-card" href={`/products?brand=${l.name}`}>
              <b aria-hidden="true">{l.letter}</b>
              <img src={l.image} alt="" loading="lazy" />
              <h3>{l.name}</h3>
              <p>{l.text}</p>
              <span class="link-arrow">Shop {l.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--gray" aria-labelledby="origin-heading">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2 id="origin-heading">Founded in Carrollton, {site.founded}.</h2>
            <p class="section-sub">OTA World began as an importer that refused to sell a chair the guest had not sat in. Twenty years later it is America’s No. 1 house of massage chairs — still shown in person, still stood behind from Carrollton.</p>
          </div>
        </div>
        <ol class="timeline">
          <li><b>{site.founded}</b><p>The house opens in Carrollton. The showroom is not a side room. It is the business.</p></li>
          <li><b>OTA</b><p>Osaki, Titan, and AmaMedic — the three names written as one house, not three catalogs.</p></li>
          <li><b>The floor</b><p>Franchise showrooms and major retail — including Costco — put the chairs where people can sit.</p></li>
          <li><b>Today</b><p>America’s No. 1 choice. A reported 35% U.S. share, in a market moving toward $3 billion.</p></li>
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="work-heading">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2 id="work-heading">One address. The rest of the company.</h2>
            <p class="section-sub">Carrollton is headquarters, showroom, stock, and service under one roof.</p>
          </div>
        </div>
        <div class="cards4">
          <article class="info-card"><span class="num">01</span><h3>Import</h3><p>Osaki, Titan, and AmaMedic come to North America through this house — one company, three names.</p></article>
          <article class="info-card"><span class="num">02</span><h3>Show</h3><p>The chair is decided in person. The flagship, partner galleries, and major retail including Costco.</p></article>
          <article class="info-card"><span class="num">03</span><h3>Stock</h3><p>Inventory lives with headquarters. A partner shows the chair without carrying a second warehouse.</p></article>
          <article class="info-card"><span class="num">04</span><h3>Stand behind</h3><p>Training, delivery, installation, and warranty stay in Carrollton — after the truck, and for the years after.</p></article>
        </div>
      </div>
    </section>

    <section class="section section--gray" aria-labelledby="hq-heading">
      <div class="wrap duo">
        <div class="duo-media">
          <img src="/assets/images/home-grid-1.jpg" alt="OTA World headquarters in Carrollton" loading="lazy" />
        </div>
        <div class="duo-copy">
          <p class="eyebrow">Headquarters</p>
          <h2 id="hq-heading">The Carrollton house</h2>
          <p>{site.addressLine}<br />{site.cityStateZip}</p>
          <p>Not a catalog wall. A working flagship — sit, stock, and service since {site.founded}.</p>
          <dl class="hours">
            <div><dt>Monday – Friday</dt><dd>{site.hoursWeekday}</dd></div>
            <div><dt>Saturday</dt><dd>{site.hoursSaturday}</dd></div>
            <div><dt>Sunday</dt><dd>{site.hoursSunday}</dd></div>
          </dl>
          <div class="btn-row">
            <a class="pill pill--dark" href="/dealers#flagship">Visit the flagship</a>
            <a class="pill pill--outline" href={`https://maps.google.com/?q=${site.mapsQuery}`} target="_blank" rel="noopener">Directions</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="purpose-heading">
      <div class="wrap">
        <h2 id="purpose-heading" class="center-title">Only a chair you have sat in is good enough.</h2>
        <div class="why">
          {purposePillars.map((pillar, i) => (
            <article>
              <span class="why-icon" aria-hidden="true">0{i + 1}</span>
              <h3>{pillar.title}</h3>
              <p>{pillar.text}</p>
              <a class="link-arrow" href={pillar.href}>{pillar.cta}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap band-inner">
        <div>
          <h2>The house does not leave with the truck.</h2>
          <p>Training, delivery, installation, and warranty — a chair of this house is kept.</p>
        </div>
        <div class="btn-row">
          <a class="pill pill--light" href="/care">Care &amp; service</a>
          <a class="pill pill--ghost" href="/products">Shop the lineup</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
